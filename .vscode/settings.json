{
  "files.exclude": {
    "**/.git": true,
    "**/.worktrees": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/tmp": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.worktrees": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/tmp": true
  },
  "eslint.options": {
    "overrideConfigFile": "config/eslint.config.mjs"
  },
  "eslint.workingDirectories": [
    {
      "directory": ".",
      "changeProcessCWD": true
    }
  ],
  "prettier.configPath": "config/prettier.json",
  "prettier.ignorePath": "config/prettierignore"
}
