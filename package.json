{
  "name": "vertice-consultoria",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @vertice/frontend",
    "test": "npm run test --workspace @vertice/frontend",
    "lint": "eslint . --config config/eslint.config.mjs --max-warnings 0",
    "format": "prettier . --config config/prettier.json --ignore-path .gitignore --ignore-path config/prettierignore --write",
    "format:check": "prettier . --config config/prettier.json --ignore-path .gitignore --ignore-path config/prettierignore --check",
    "typecheck": "npm run typecheck --workspace @vertice/frontend",
    "build": "npm run build --workspace @vertice/frontend",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "typescript-eslint": "^8.64.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
